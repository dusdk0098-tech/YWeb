# Copy to .env. Generate your own secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=http://127.0.0.1:3000
PORT=3000
DB_PATH=./data/pedit.sqlite
ADS_ENABLED=false
# This foundation binds loopback only; production is intentionally refused.
NODE_ENV=development
# Optional AI wording suggestion (SC-04). Prefer the in-app "AI 문구 설정" screen (one key for this PC, or a key per account).
# Setting both values below instead overrides the in-app setting; only the expense description text is sent to Claude.
# Credentials: ANTHROPIC_API_KEY here, or an `ant auth login` profile. Cap = requests per calendar month.
AI_ENABLED=false
AI_MONTHLY_REQUEST_LIMIT=0
# AI_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=
