# Copy to .env. Generate your own secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=http://127.0.0.1:3000
PORT=3000
DB_PATH=./data/pedit.sqlite
# 광고 (docs/ADS.md): 개발자 광고 피드를 하루 한 번 받아 홈에 표시합니다. 끄는 설정은 없고, 피드 주소만 ADS_FEED_URL=로 바꿀 수 있습니다.
# ADS_FEED_URL=https://dusdk0098-tech.github.io/yweb-ads/ads.json
# This foundation binds loopback only; production is intentionally refused.
NODE_ENV=development
# Optional AI wording suggestion (SC-04). Prefer the in-app "AI 문구 설정" screen (one key for this PC, or a key per account).
# Setting both values below instead overrides the in-app setting; only the expense description text is sent to Claude.
# Credentials: ANTHROPIC_API_KEY here, or an `ant auth login` profile. Cap = requests per calendar month.
AI_ENABLED=false
AI_MONTHLY_REQUEST_LIMIT=0
# AI_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=
# Internet access (외부 접속 설정 screen and its wizard, docs/SELF_HOSTING.md). Optional overrides only:
# YWEB_LAUNCHER is set by start.cmd (it enables the wizard's "다시 시작해 적용" button). Do not set it here.
# PUBLIC_HTTP_PORT=80
# PUBLIC_HTTPS_PORT=443
# TLS_DIR=./data/tls
# CLOUDFLARED_PATH=C:\Program Files (x86)\cloudflared\cloudflared.exe
